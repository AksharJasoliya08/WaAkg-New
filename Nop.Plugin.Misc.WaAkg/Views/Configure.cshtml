                    @* ---------------- TAB 7 : ERRORS ---------------- *@
                    <nop-tab asp-name="tab-errors" asp-title="Errors">
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3">
                                <button type="button" id="waakg-e-refresh" class="btn btn-default">
                                    <i class="fas fa-rotate"></i> Refresh
                                </button>
                                <button type="button" id="waakg-e-clear" class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Clear all
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-bordered table-sm" id="waakg-error-table">
                                <thead>
                                    <tr>
                                        <th>When</th>
                                        <th>Source</th>
                                        <th>Phone</th>
                                        <th>Message</th>
                                        <th>Detail</th>
                                    </tr>
                                </thead>
                                <tbody id="waakg-error-tbody">
                                    <tr><td colspan="5" class="text-center">Loading…</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div id="waakg-error-summary" style="color:#666;"></div>
                            <div>
                                <button type="button" id="waakg-e-prev" class="btn btn-default btn-sm">&laquo; Prev</button>
                                <span id="waakg-e-pageinfo" style="margin:0 8px;"></span>
                                <button type="button" id="waakg-e-next" class="btn btn-default btn-sm">Next &raquo;</button>
                            </div>
                        </div>

                        <script asp-location="Footer">
                            (function () {
                                var state = { page: 1, pageSize: 20 };

                                function escapeHtml(text) {
                                    if (text === null || text === undefined) return '';
                                    return String(text)
                                        .replace(/&/g, '&amp;')
                                        .replace(/</g, '&lt;')
                                        .replace(/>/g, '&gt;')
                                        .replace(/"/g, '&quot;');
                                }

                                function rowHtml(row) {
                                    var when = row.CreatedOn ? new Date(row.CreatedOn).toLocaleString() : '';
                                    return '<tr>' +
                                        '<td>' + escapeHtml(when) + '</td>' +
                                        '<td>' + escapeHtml(row.Source) + '</td>' +
                                        '<td>' + escapeHtml(row.Phone) + '</td>' +
                                        '<td style="max-width:260px;white-space:pre-wrap;color:#c00;">' + escapeHtml(row.Message) + '</td>' +
                                        '<td style="max-width:320px;white-space:pre-wrap;font-size:11px;color:#666;">' + escapeHtml(row.Detail) + '</td>' +
                                    '</tr>';
                                }

                                function loadErrors() {
                                    var $tbody = $('#waakg-error-tbody');
                                    $tbody.html('<tr><td colspan="5" class="text-center">Loading…</td></tr>');

                                    $.ajax({
                                        cache: false,
                                        type: 'POST',
                                        url: '@(Url.Action("ErrorList", "WaAkgAdmin", new { area = "Admin" }))',
                                        data: addAntiForgeryToken({ page: state.page, pageSize: state.pageSize }),
                                        success: function (response) {
                                            var items = (response && response.Data) || [];

                                            if (!items.length) {
                                                $tbody.html('<tr><td colspan="5" class="text-center">No errors recorded.</td></tr>');
                                            } else {
                                                var html = '';
                                                for (var i = 0; i < items.length; i++) html += rowHtml(items[i]);
                                                $tbody.html(html);
                                            }

                                            var total = (response && response.Total) || items.length;
                                            var totalPages = Math.max(1, Math.ceil(total / state.pageSize));
                                            $('#waakg-error-summary').text(total + ' error(s) total.');
                                            $('#waakg-e-pageinfo').text('Page ' + state.page + ' of ' + totalPages);
                                        },
                                        error: function () {
                                            $tbody.html('<tr><td colspan="5" class="text-center" style="color:#c00;">Failed to load errors.</td></tr>');
                                        }
                                    });
                                }

                                $('#waakg-e-refresh').on('click', loadErrors);
                                $('#waakg-e-prev').on('click', function () { if (state.page > 1) { state.page--; loadErrors(); } });
                                $('#waakg-e-next').on('click', function () { state.page++; loadErrors(); });
                                $('#waakg-e-clear').on('click', function () {
                                    if (!confirm('Delete every error log entry?')) return;
                                    $.ajax({
                                        cache: false,
                                        type: 'POST',
                                        url: '@(Url.Action("ClearErrors", "WaAkgAdmin", new { area = "Admin" }))',
                                        data: addAntiForgeryToken({}),
                                        success: function () { state.page = 1; loadErrors(); }
                                    });
                                });

                                $('a[href="#tab-errors"]').one('shown.bs.tab', loadErrors);
                                if ($('#tab-errors').is(':visible')) loadErrors();
                            })();
                        </script>
                    </nop-tab>

                </nop-tabs>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" value="save" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</form>

<script asp-location="Footer">
    $(function () {
        $('#waakg-test-connection').on('click', function () {
            var $result = $('#waakg-test-result').removeClass().text('Testing…');
            $.ajax({
                cache: false,
                type: 'POST',
                url: '@(Url.Action("TestConnection", "WaAkgAdmin", new { area = "Admin" }))',
                data: addAntiForgeryToken({
                    apiBaseUrl: $('#ApiBaseUrl').val(),
                    apiKey: $('#ApiKey').val(),
                    sessionId: $('#SessionId').val()
                }),
                success: function (response) {
                    $result.text(response.message).css('color', response.success ? 'green' : 'red');
                    if (response.raw) {
                        $('#waakg-test-raw').show().text(response.raw);
                    }
                },
                error: function () {
                    $result.text('Request failed').css('color', 'red');
                }
            });
        });

        $('#waakg-send-test').on('click', function () {
            var $result = $('#waakg-send-test-result').text('Sending…');
            $.ajax({
                cache: false,
                type: 'POST',
                url: '@(Url.Action("SendTest", "WaAkgAdmin", new { area = "Admin" }))',
                data: addAntiForgeryToken({ phone: $('#waakg-test-phone').val(), message: '' }),
                success: function (response) {
                    $result.text(response.message).css('color', response.success ? 'green' : 'red');
                },
                error: function () {
                    $result.text('Request failed').css('color', 'red');
                }
            });
        });
    });
</script>
