@model int

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>
    #wa-otp-overlay {
        position: fixed;
        inset: 0;
        z-index: 100000;
        background: rgba(20, 10, 22, 0.72);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        box-sizing: border-box;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    #wa-otp-card {
        width: 100%;
        max-width: 400px;
        background: #ffffff;
        border-radius: 18px;
        padding: 0;
        box-sizing: border-box;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.4);
        position: relative;
        overflow: hidden;
        max-height: calc(100vh - 32px);
        display: flex;
        flex-direction: column;
    }

    .wa-otp-header {
        background: linear-gradient(135deg, #128c4a, #25d366);
        padding: 22px 24px 18px;
        text-align: center;
        flex-shrink: 0;
    }

    .wa-otp-header .wa-otp-icon-circle {
        width: 48px;
        height: 48px;
        margin: 0 auto 10px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .wa-otp-header .wa-otp-icon-circle i {
        font-size: 22px;
        color: #fff;
    }

    .wa-otp-title {
        margin: 0 0 4px;
        color: #fff;
        font-size: 19px;
        font-weight: 700;
        text-align: center;
    }

    .wa-otp-subtitle {
        margin: 0;
        color: rgba(255, 255, 255, 0.9);
        font-size: 13px;
        text-align: center;
        line-height: 1.4;
    }

    .wa-otp-body {
        padding: 24px;
        overflow-y: auto;
    }

    .wa-otp-step { display: none; }
    .wa-otp-step.active { display: block; }

    .wa-otp-label {
        font-size: 12px;
        font-weight: 600;
        color: #666;
        margin-bottom: 6px;
        display: block;
    }

    .wa-otp-phone-row {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        padding: 0 14px;
        margin-bottom: 16px;
        transition: border-color 0.15s ease;
        background: #fafafa;
    }

    .wa-otp-phone-row:focus-within {
        border-color: #25d366;
        background: #fff;
    }

    .wa-otp-phone-row .wa-otp-cc {
        color: #444;
        font-weight: 600;
        font-size: 15px;
        padding-right: 8px;
        border-right: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .wa-otp-phone-row .wa-otp-cc i {
        color: #999;
        font-size: 13px;
    }

    #wa-otp-phone {
        flex: 1;
        border: none;
        outline: none;
        padding: 13px 0;
        font-size: 16px;
        color: #321936;
        background: transparent;
        min-width: 0;
        width: 100%;
    }

    .wa-otp-btn {
        width: 100%;
        padding: 14px 0;
        border: none;
        border-radius: 10px;
        background: #25d366;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s ease, opacity 0.15s ease, transform 0.1s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .wa-otp-btn:hover:not(:disabled) {
        background: #1fb855;
    }

    .wa-otp-btn:active:not(:disabled) {
        transform: scale(0.98);
    }

    .wa-otp-btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .wa-otp-boxes {
        display: flex;
        justify-content: space-between;
        gap: 6px;
        margin-bottom: 16px;
    }

    .wa-otp-box {
        width: 100%;
        max-width: 46px;
        aspect-ratio: 1 / 1.1;
        text-align: center;
        font-size: 20px;
        font-weight: 700;
        color: #321936;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        outline: none;
        background: #fafafa;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .wa-otp-box:focus {
        border-color: #25d366;
        background: #fff;
    }

    .wa-otp-resend-row {
        text-align: center;
        font-size: 13px;
        color: #999;
        margin-bottom: 16px;
    }

    .wa-otp-resend-row a {
        color: #25d366;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
    }

    .wa-otp-resend-row a:hover {
        text-decoration: underline;
    }

    .wa-otp-status {
        min-height: 18px;
        text-align: center;
        font-size: 13px;
        color: #e0324c;
        margin-bottom: 12px;
        line-height: 1.4;
        word-break: break-word;
    }

    .wa-otp-status i {
        margin-right: 4px;
    }

    .wa-otp-spinner-row {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #666;
        font-size: 13px;
        margin-top: 12px;
    }

    .wa-otp-spinner-row i {
        color: #25d366;
        font-size: 15px;
    }

    .wa-otp-change-number {
        display: block;
        text-align: center;
        margin-top: 14px;
        font-size: 12px;
        color: #999;
        cursor: pointer;
    }

    .wa-otp-change-number:hover {
        color: #666;
        text-decoration: underline;
    }

    .wa-otp-trust-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #f0f0f0;
        font-size: 11px;
        color: #aaa;
    }

    .wa-otp-trust-row i {
        color: #bbb;
        font-size: 12px;
    }

    @@media (max-width: 420px) {
        #wa-otp-card { max-width: 100%; border-radius: 16px; }
        .wa-otp-header { padding: 18px 18px 14px; }
        .wa-otp-body { padding: 18px; }
        .wa-otp-box { max-width: 42px; font-size: 18px; }
    }

    @@media (max-width: 340px) {
        .wa-otp-boxes { gap: 4px; }
        .wa-otp-box { max-width: 36px; font-size: 16px; }
    }

    @@keyframes wa-otp-spin {
        to { transform: rotate(360deg); }
    }

    .wa-otp-spin-icon {
        animation: wa-otp-spin 0.8s linear infinite;
    }
</style>

<div id="wa-otp-overlay">
    <div id="wa-otp-card">

        <div class="wa-otp-header">
            <div class="wa-otp-icon-circle"><i class="fa-brands fa-whatsapp"></i></div>
            <p class="wa-otp-title" id="wa-otp-header-title">Login with WhatsApp</p>
            <p class="wa-otp-subtitle" id="wa-otp-header-subtitle">We'll send a one-time code to verify your number</p>
        </div>

        <div class="wa-otp-body">

            @* ---------------- STEP 1: phone ---------------- *@
            <div id="wa-otp-step-phone" class="wa-otp-step active">
                <span class="wa-otp-label">Mobile number</span>
                <div class="wa-otp-phone-row">
                    <span class="wa-otp-cc"><i class="fa-solid fa-flag"></i>+91</span>
                    <input type="tel" id="wa-otp-phone" inputmode="numeric" maxlength="10" placeholder="9876543210" autocomplete="tel" />
                </div>

                <div id="wa-otp-phone-status" class="wa-otp-status"></div>

                <button type="button" id="wa-otp-send-btn" class="wa-otp-btn">
                    <i class="fa-solid fa-paper-plane"></i><span>Send OTP</span>
                </button>

                <div class="wa-otp-trust-row">
                    <i class="fa-solid fa-lock"></i><span>Your number is safe with us</span>
                </div>
            </div>

            @* ---------------- STEP 2: OTP boxes ---------------- *@
            <div id="wa-otp-step-otp" class="wa-otp-step">
                <span class="wa-otp-label" style="text-align:center; display:block;">Enter the 6-digit code</span>
                <p class="wa-otp-subtitle" id="wa-otp-sent-to" style="color:#888; margin-bottom:16px;">Sent to your WhatsApp</p>

                <div class="wa-otp-boxes">
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="0" />
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="1" />
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="2" />
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="3" />
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="4" />
                    <input type="text" class="wa-otp-box" inputmode="numeric" maxlength="1" data-idx="5" />
                </div>

                <div class="wa-otp-resend-row">
                    <span id="wa-otp-resend-waiting"><i class="fa-regular fa-clock"></i> Resend OTP in <span id="wa-otp-countdown">45</span>s</span>
                    <a id="wa-otp-resend-link" style="display:none;"><i class="fa-solid fa-rotate-right"></i> Resend OTP</a>
                </div>

                <div id="wa-otp-verify-status" class="wa-otp-status"></div>

                <button type="button" id="wa-otp-confirm-btn" class="wa-otp-btn">
                    <i class="fa-solid fa-check"></i><span>Confirm</span>
                </button>

                <div id="wa-otp-spinner-row" class="wa-otp-spinner-row">
                    <i class="fa-solid fa-circle-notch wa-otp-spin-icon"></i>
                    <span>Logging in...</span>
                </div>

                <span id="wa-otp-change-number" class="wa-otp-change-number">
                    <i class="fa-solid fa-pen"></i> Change phone number
                </span>
            </div>

        </div>

    </div>
</div>

<script asp-location="Footer">
    (function () {
        // Lock body scroll while the gate is up - the popup is not dismissible.
        document.body.style.overflow = 'hidden';

        var state = {
            phone: '',
            cooldownSeconds: @Model,
            countdownTimer: null
        };

        function showStep(step) {
            $('.wa-otp-step').removeClass('active');
            $('#wa-otp-step-' + step).addClass('active');
        }

        function setStatus(el, text, isError) {
            var html = text ? '<i class="fa-solid fa-circle-exclamation"></i>' + text : '';
            $(el).html(html).css('color', isError === false ? '#666' : '#e0324c');
        }

        function startCountdown(seconds) {
            clearInterval(state.countdownTimer);
            var remaining = seconds;

            $('#wa-otp-resend-link').hide();
            $('#wa-otp-resend-waiting').show();
            $('#wa-otp-countdown').text(remaining);

            state.countdownTimer = setInterval(function () {
                remaining--;
                if (remaining <= 0) {
                    clearInterval(state.countdownTimer);
                    $('#wa-otp-resend-waiting').hide();
                    $('#wa-otp-resend-link').show();
                    return;
                }
                $('#wa-otp-countdown').text(remaining);
            }, 1000);
        }

        function setSendBtnState(sending) {
            var $btn = $('#wa-otp-send-btn');
            $btn.prop('disabled', sending);
            $btn.html(sending
                ? '<i class="fa-solid fa-circle-notch wa-otp-spin-icon"></i><span>Sending...</span>'
                : '<i class="fa-solid fa-paper-plane"></i><span>Send OTP</span>');
        }

        function sendOtp() {
            var phone = $('#wa-otp-phone').val().replace(/\D/g, '');

            if (phone.length !== 10) {
                setStatus('#wa-otp-phone-status', 'Enter a valid 10-digit phone number.');
                return;
            }

            state.phone = phone;
            setSendBtnState(true);
            setStatus('#wa-otp-phone-status', '');

            $.ajax({
                cache: false,
                type: 'POST',
                url: '/wa-otp/send',
                contentType: 'application/json',
                data: JSON.stringify({ phone: phone }),
                success: function (response) {
                    setSendBtnState(false);

                    var isOk = response && (response.success === true || response.Success === true);
                    if (!isOk) {
                        var message = (response && (response.error || response.Error)) || 'Could not send the OTP. Please try again.';
                        setStatus('#wa-otp-phone-status', message);
                        return;
                    }

                    $('#wa-otp-sent-to').text('Sent to ' + phone);
                    showStep('otp');
                    startCountdown(response.cooldownSeconds || response.CooldownSeconds || state.cooldownSeconds);

                    setTimeout(function () {
                        $('.wa-otp-box[data-idx="0"]').trigger('focus');
                    }, 50);
                },
                error: function () {
                    setSendBtnState(false);
                    setStatus('#wa-otp-phone-status', 'Could not reach the server. Please try again.');
                }
            });
        }

        function collectOtp() {
            var digits = '';
            $('.wa-otp-box').each(function () { digits += ($(this).val() || '').trim(); });
            return digits;
        }

        function verifyOtp() {
            var otp = collectOtp();
            if (otp.length !== 6) return;

            setStatus('#wa-otp-verify-status', '');
            $('#wa-otp-confirm-btn').prop('disabled', true);
            $('#wa-otp-spinner-row').css('display', 'flex');

            $.ajax({
                cache: false,
                type: 'POST',
                url: '/wa-otp/verify',
                contentType: 'application/json',
                data: JSON.stringify({ phone: state.phone, otp: otp }),
                success: function (response) {
                    var isOk = response && (response.success === true || response.Success === true);
                    if (isOk) {
                        setStatus('#wa-otp-verify-status', 'Logging in…', false);
                        $('#wa-otp-spinner-row').css('display', 'flex');
                        setTimeout(function () { window.location.reload(); }, 900);
                        return;
                    }

                    $('#wa-otp-spinner-row').hide();
                    $('#wa-otp-confirm-btn').prop('disabled', false);

                    var locked = response && (response.locked === true || response.Locked === true);
                    var message = (response && (response.error || response.Error)) || 'Incorrect OTP. Please try again.';
                    setStatus('#wa-otp-verify-status', message);

                    if (locked) {
                        $('.wa-otp-box').prop('disabled', true);
                    } else {
                        $('.wa-otp-box').val('');
                        $('.wa-otp-box[data-idx="0"]').trigger('focus');
                    }
                },
                error: function () {
                    $('#wa-otp-spinner-row').hide();
                    $('#wa-otp-confirm-btn').prop('disabled', false);
                    setStatus('#wa-otp-verify-status', 'Something went wrong. Please try again.');
                }
            });
        }

        $('#wa-otp-send-btn').on('click', sendOtp);
        $('#wa-otp-phone').on('keypress', function (e) { if (e.which === 13) sendOtp(); });

        $('#wa-otp-confirm-btn').on('click', verifyOtp);

        $('#wa-otp-resend-link').on('click', function () {
            $('.wa-otp-box').val('');
            sendOtp();
        });

        $('#wa-otp-change-number').on('click', function () {
            clearInterval(state.countdownTimer);
            $('.wa-otp-box').val('');
            setStatus('#wa-otp-verify-status', '');
            showStep('phone');
            setTimeout(function () { $('#wa-otp-phone').trigger('focus'); }, 50);
        });

        // ---- OTP box behaviour: auto-advance, backspace nav, paste, auto-verify ----
        $('.wa-otp-box').on('input', function () {
            var $this = $(this);
            $this.val($this.val().replace(/\D/g, '').slice(0, 1));

            if ($this.val().length === 1) {
                var next = $this.data('idx') + 1;
                if (next < 6) {
                    $('.wa-otp-box[data-idx="' + next + '"]').trigger('focus');
                } else {
                    verifyOtp();
                }
            }
        });

        $('.wa-otp-box').on('keydown', function (e) {
            var $this = $(this);
            if (e.key === 'Backspace' && $this.val() === '') {
                var prev = $this.data('idx') - 1;
                if (prev >= 0) {
                    $('.wa-otp-box[data-idx="' + prev + '"]').trigger('focus');
                }
            }
        });

        $('.wa-otp-box').on('paste', function (e) {
            var pasted = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
            var digits = (pasted || '').replace(/\D/g, '').slice(0, 6);
            if (!digits.length) return;

            e.preventDefault();
            for (var i = 0; i < 6; i++) {
                $('.wa-otp-box[data-idx="' + i + '"]').val(digits[i] || '');
            }

            if (digits.length === 6) {
                verifyOtp();
            } else {
                $('.wa-otp-box[data-idx="' + digits.length + '"]').trigger('focus');
            }
        });

        setTimeout(function () { $('#wa-otp-phone').trigger('focus'); }, 50);
    })();
</script>
